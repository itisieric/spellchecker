<Window x:Class="LLMAutocorrect.Autocomplete.SuggestionOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        SizeToContent="WidthAndHeight" Focusable="False">
  <Border Background="#EE202124" BorderBrush="#554F46E5" BorderThickness="1"
          CornerRadius="6" Padding="10,6" MaxWidth="620">
    <StackPanel Orientation="Horizontal">
      <Border x:Name="TerminalTag" Background="#3346A758" CornerRadius="3" Padding="5,2" Margin="0,0,8,0" Visibility="Collapsed">
        <TextBlock Text="TERMINAL" Foreground="#FFC8F7D0" FontSize="10" FontWeight="SemiBold" />
      </Border>
      <TextBlock x:Name="SuggestionText" Foreground="#FFE8EAED" FontSize="14"
                 TextWrapping="Wrap" MaxWidth="520" VerticalAlignment="Center" />
      <TextBlock x:Name="CounterText" Foreground="#FF9AA0A6" FontSize="11"
                 Margin="10,0,6,0" VerticalAlignment="Center" />
      <Border x:Name="NextHint" Background="#225F6368" CornerRadius="3" Padding="5,2" Margin="0,0,5,0">
        <TextBlock Text="ALT+↓ NEXT" Foreground="#FFD0D3D7" FontSize="10" FontWeight="SemiBold" />
      </Border>
      <Border Background="#334F46E5" CornerRadius="3" Padding="5,2">
        <TextBlock Text="TAB" Foreground="#FFBFC5FF" FontSize="10" FontWeight="SemiBold" />
      </Border>
    </StackPanel>
  </Border>
</Window>
