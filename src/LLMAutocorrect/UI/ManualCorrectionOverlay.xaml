<Window x:Class="LLMAutocorrect.UI.ManualCorrectionOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        SizeToContent="WidthAndHeight">
  <Border Background="#FFF7F7F8" BorderBrush="#FFB8BBC0" BorderThickness="1"
          CornerRadius="4" Padding="3">
    <Button x:Name="CorrectButton" Click="CorrectButton_Click" Padding="10,6"
            Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left">
      <StackPanel>
        <TextBlock Text="Spelling correction" Foreground="#FF202124" FontWeight="SemiBold" />
        <TextBlock x:Name="PreviewText" Foreground="#FF5F6368" FontSize="11" MaxWidth="260"
                   TextTrimming="CharacterEllipsis" />
      </StackPanel>
    </Button>
  </Border>
</Window>
